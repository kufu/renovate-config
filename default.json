{
  "extends": [
    ":timezone(Asia/Tokyo)",
    "group:monorepos",
    "group:react",
    "group:stylelint",
    ":widenPeerDependencies",
    ":label(renovate)",
    ":semanticCommits",
    ":semanticCommitScopeDisabled",
    ":configMigration",
    "security:minimumReleaseAgeNpm"
  ],
  "rebaseWhen": "never",
  "schedule": "after 8am and before 5pm every weekday",
  "registryAliases": {
    "mirror.gcr.io": "docker.io"
  },
  "packageRules": [
    {
      "description": "minimumReleaseAgeを社内規定に沿って7 daysにセットする",
      "internalChecksFilter": "strict",
      "matchUpdateTypes": ["major", "minor", "patch", "digest", "pinDigest"],
      "minimumReleaseAge": "7 days"
    }
  ],
  "npm": {
    "extends": [
      ":noUnscheduledUpdates",
      "helpers:disableTypesNodeMajor"
    ],
    "rangeStrategy": "bump",
    "semanticCommitType": "chore",
    "separateMinorPatch": true,
    "packageRules": [
      {
        "matchDepTypes": [
          "devDependencies"
        ],
        "matchUpdateTypes": [
          "patch"
        ],
        "automerge": true
      },
      {
        "matchPackageNames": ["ua-parser-js"],
        "allowedVersions": "<2.0.0"
      }
    ]
  }
}
